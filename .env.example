# Template .env projek IT-Tiket - SATU tempat sahaja: fail ini di root.
# Salin ke `.env.local` (fail yang awak isi sendiri), tampal nilai, langsung jalan.
# Selepas isi: powershell toolbox/check-supabase-config.ps1
#   (web/ di Next.js diselaras automatik bila npm run dev / build.)
#
# 2 nilai pertama: https://supabase.com/dashboard/project/<PROJECT_REF>/settings/api
#   Project URL -> NEXT_PUBLIC_SUPABASE_URL   (bentuk: https://<20-huruf-nombor>.supabase.co)
#   anon public -> NEXT_PUBLIC_SUPABASE_ANON_KEY (bermula "eyJ" atau "sb_publishable_")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya server (skrin admin: urus pengguna). JANGAN prefix NEXT_PUBLIC_ dan jangan import dalam kod klien.
SUPABASE_SERVICE_ROLE_KEY=
# Pilihan: JSON RTCIceServer (tambah TURN untuk produksi). Kosong = STUN awam sahaja.
NEXT_PUBLIC_ICE_SERVERS=
# Pilihan direct connection Postgres (dibenarkan untuk CLI/toolbox sahaja, BUKAN Next.js):
#   SUPABASE_DB_PASSWORD=<kata-laluan DB projek>
#   SUPABASE_DB_URL=<postgresql://postgres:<kata-laluan>@aws-0-<wilayah>.pooler.supabase.com:5432/postgres>
# Kosong = ops CLI jalan ikut access token sahaja (cukup untuk link + db push).
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_URL=
